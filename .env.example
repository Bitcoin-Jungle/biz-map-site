# Apple MapKit private key PEM, with newlines escaped as \n.
APPLE_MAPS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Apple developer team id used as the MapKit JWT issuer.
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"

# Apple MapKit key id used as the JWT kid header.
MAPS_KEY_ID="YOUR_MAPKIT_KEY_ID"

# Browser origin allowed in the MapKit JWT.
SITE_ORIGIN="https://maps.bitcoinjungle.app"

# SendGrid API key for approval emails; leave blank to log emails in development.
SENDGRID_API_KEY=""

# Shared secret required by /api/approve and /api/reject moderation links.
APPROVE_KEY="change-me"

# Public base URL used when building moderation links in approval emails.
PUBLIC_URL="http://localhost:8080"

# HTTP port for the Fastify backend.
PORT="8080"

# SQLite database file for the merchant submission queue.
DB_PATH="./data/submissions.db"

# BTC Map JSON-RPC endpoint for Import RPC.
BTCMAP_RPC_URL="https://api.btcmap.org/rpc"

# BTC Map Import RPC bearer token scoped to import_origins ["bitcoin-jungle"].
IMPORT_TOKEN=""
